# Copy to .env and adjust for your machine:
#   cp .env.example .env

# Active compose profile (used by scripts/model-switch.sh)
COMPOSE_FILE=docker-compose.cpu.yml

# Shared LLM advisor settings (referenced in compose files)
OLLAMA_MODEL=qwen2.5:0.5b
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=WARNING
FRONTEND_PORT=8080

# --- Reference: GPU profile (docker-compose.gpu.yml) ---
# OLLAMA_MODEL=qwen2.5:0.5b
# OLLAMA_CONTEXT_LENGTH=4096
# NUM_CTX=4096
# MAX_TOKENS=256
# ollama mem_limit=4g, llm-advisor mem_limit=2g
# Requires NVIDIA runtime + drivers

# --- Reference: CPU profile (docker-compose.cpu.yml) ---
# OLLAMA_MODEL=qwen2.5:0.5b
# OLLAMA_CONTEXT_LENGTH=2048
# NUM_CTX=2048
# MAX_TOKENS=128
# OLLAMA_NUM_THREADS=4
# ollama mem_limit=2g, llm-advisor mem_limit=1g
