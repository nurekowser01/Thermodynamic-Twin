# Reference only — override these in docker-compose.yml environment: blocks

# Ollama
OLLAMA_MODEL=smollm:135m
OLLAMA_MEMORY_LIMIT=800m
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=2048

# LLM Advisor
LLM_MEMORY_LIMIT=512m
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_REQUEST_TIMEOUT=90
TEMPERATURE=0.0
MAX_TOKENS=256
NUM_CTX=2048
MAX_CONTEXT_CHARS=1500
MAX_CHAT_HISTORY=4
LOG_LEVEL=WARNING
CORS_ORIGINS=http://localhost:8080

# Backend / Frontend
BACKEND_MEMORY_LIMIT=768m
FRONTEND_MEMORY_LIMIT=128m
FRONTEND_PORT=8080

# GPU (optional — uncomment in docker-compose.yml for NVIDIA)
# deploy.resources.reservations.devices:
#   - capabilities: [gpu]
