# Reference only — override these in docker-compose.yml environment: blocks

# Ollama
OLLAMA_MODEL=llama3.2:3b
OLLAMA_MEMORY_LIMIT=8g

# LLM Advisor
LLM_MEMORY_LIMIT=4g
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_REQUEST_TIMEOUT=120
TEMPERATURE=0.3
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080

# Backend / Frontend
BACKEND_MEMORY_LIMIT=2g
FRONTEND_MEMORY_LIMIT=512M
FRONTEND_PORT=8080

# GPU (optional — uncomment in docker-compose.yml for NVIDIA)
# deploy.resources.reservations.devices:
#   - capabilities: [gpu]
